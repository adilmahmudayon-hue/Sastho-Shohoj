# Copy this file to ".env" and fill in your values. Never commit ".env".
PORT=3000

# Secret used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Email (SMTP). Leave SMTP_HOST empty to run in DEV MODE (passwords print in the server console).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="Serial <your-email@gmail.com>"
